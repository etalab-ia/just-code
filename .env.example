# Requis : clé du provider Albert API. Ne jamais commiter une vraie valeur.
ALBERT_API_KEY=

# Tous les paramètres ci-dessous sont optionnels.

# Runtime préféré. Sans cette ligne, microsandbox est utilisé : c'est le runtime
# à espace de travail scellé, donc le défaut sûr à zéro option.
# --tart et --agent-vm restent sélectionnables explicitement.
# RUNTIME=microsandbox
# RUNTIME=tart
# RUNTIME=agent-vm

# Niveau d'isolation. Sans cette ligne, « full » est utilisé : tout l'agent,
# TUI et identifiants compris, tourne dans l'invité.
# ISOLATION=backend

# Racine du runtime et de l'état Microsandbox gérés (défaut : ~/.microsandbox).
# MSB_HOME=/chemin/vers/microsandbox
# Alternative administrée manuellement : définir les deux chemins ensemble.
# MSB_PATH=/chemin/vers/msb
# MSB_LIBKRUNFW_PATH=/chemin/vers/libkrunfw

# Source du contenu du projet.
# Microsandbox : répertoire hôte dont le contenu est transféré, filtré, vers
# l'invité (aucun montage). Défaut : la racine du projet.
# Tart / agent-vm : répertoire monté sur /workspace. Même défaut (racine du
# projet), donc la porte de sécurité de ces runtimes porte sur le projet.
# Microsandbox n'a pas de montage : changer la source prend effet au
# `workspace sync` suivant. Pour agent-vm, le disque est figé au clonage et
# changer de source impose de recréer la VM ; Tart relit le montage à chaque
# `tart run`, donc un redémarrage simple suffit.
# WORKSPACE_DIR=/chemin/absolu/vers/le/projet
# PROJECT_DIR est déprécié, utiliser WORKSPACE_DIR.

# Authentification HTTP du backend. Valeurs par défaut ci-dessous.
# Un mot de passe explicitement vide désactive l'authentification.
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=albert-dev-pass

# Image Tart : Tahoe par défaut (Xcode 26.3+), Sonoma pour Xcode 16.2 et antérieurs.
# TART_IMAGE=ghcr.io/cirruslabs/macos-tahoe-base:latest
# TART_IMAGE=ghcr.io/cirruslabs/macos-sonoma-base:latest

# MTU invitée : 1280 par défaut pour limiter les blocages TLS avec certains VPN.
# Entier de 1280 à 1500, ou auto pour laisser la MTU inchangée.
# TART_MTU=1280

# Runtime agent-vm : template Lima de base et nom de la VM gérée par just-code.
# Le template par défaut est construit par just-code s'il est absent ; un autre
# nom désigne un template que vous maintenez, jamais construit ni remplacé.
# AGENT_VM_TEMPLATE=agent-vm-base
# AGENT_VM_VM=opencode-agent-vm

# Ressources du template de base. Lima n'agrandit un disque que dans ce sens :
# prévoir large si des outils doivent être ajoutés à l'image.
# AGENT_VM_IMAGE=template:debian-13
# AGENT_VM_DISK_GB=20
# AGENT_VM_MEMORY_GB=4
# AGENT_VM_CPUS=2

# Délai d'attente du backend, en secondes (300 par défaut). Le premier démarrage
# Microsandbox installe ~384 Mio de paquets dans la microVM et peut être long.
# JUST_CODE_START_TIMEOUT=300
