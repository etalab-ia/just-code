# Requis pour le provider Albert
ALBERT_API_KEY=

# Paramètres optionnels
# Décommente un runtime pour éviter de le préciser à chaque commande
# RUNTIME=docker
# RUNTIME=microsandbox
# RUNTIME=tart
# WORKSPACE_DIR=/chemin/absolu/vers/le/projet
# Image Tart : Tahoe par défaut (Xcode 26.3+), Sonoma pour Xcode 16.2 et antérieurs.
# TART_IMAGE=ghcr.io/cirruslabs/macos-tahoe-base:latest
# TART_IMAGE=ghcr.io/cirruslabs/macos-sonoma-base:latest
# MTU invitée : 1280 par défaut pour limiter les blocages TLS avec certains VPN.
# Entier de 1280 à 1500, ou auto pour laisser la MTU inchangée.
# TART_MTU=1280
# Attente maximale du backend après démarrage, en secondes (300 par défaut).
# Le premier démarrage peut être long : installation de la toolchain Microsandbox,
# build de l'image Docker, ou installation d'OpenCode dans la VM Tart.
# JUST_CODE_START_TIMEOUT=300
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=albert-dev-pass
