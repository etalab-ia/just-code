{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "albert": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Albert API (État)",
      "options": {
        "baseURL": "https://albert.api.etalab.gouv.fr/v1",
        "apiKey": "{env:ALBERT_API_KEY}"
      },
      "models": {
        "qwen3-coder": {
          "name": "Qwen3 Coder",
          "modelID": "Qwen/Qwen3-Coder-30B-A3B-Instruct",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144
          }
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash",
          "modelID": "deepseek-ai/DeepSeek-V4-Flash-0731",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 131072,
            "output": 65536
          }
        }
      }
    }
  },
  "model": "albert/qwen3-coder",
  "small_model": "albert/qwen3-coder",
  "permission": {
    "edit": "allow",
    "external_directory": "allow",
    "bash": {
      ".*": "allow",
      "git push.*(--force|-f | --force-with-lease)": "deny",
      "sudo .*": "deny"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "skill": "allow",
    "task": "allow"
  }
}
